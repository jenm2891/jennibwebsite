{
  "name": "jennib-commerce-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jennib-blog",
      "database_id": "74d2c5d7-ad53-4175-a0ef-177358f8c4bd"
    }
  ],
  "routes": [
    {
      "pattern": "backend.jennibee.art",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://jennibee.art,https://www.jennibee.art,https://jennibwebsite.pages.dev",
    "PUBLIC_SITE_ORIGIN": "https://jennibee.art",
    "BLOG_ADMIN_USERNAMES": "j3nn1b33",
    "BLOG_ADMIN_EMAILS": "jenni@jennibee.art",
    "ENVIRONMENT": "production"
  }
}